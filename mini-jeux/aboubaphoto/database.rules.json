{
  "rules": {
    ".read": false,
    ".write": false,
    "photoRooms": {
      "$room": {
        ".read": "auth != null && root.child('photoRooms').child($room).child('host').val() === auth.uid && root.child('photoRooms').child($room).child('expiresAt').val() > now",
        ".write": "auth != null && (!newData.exists() || (!data.exists() && newData.child('host').val() === auth.uid) || data.child('host').val() === auth.uid)",
        ".validate": "newData.hasChildren(['host','createdAt','expiresAt','players']) && $room.matches(/^[a-f0-9]{36}$/)",
        "host": {
          ".validate": "newData.isString() && (data.exists() ? newData.val() === data.val() : newData.val() === auth.uid)"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && ((!data.exists() && newData.val() <= now + 60000 && newData.val() >= now - 60000) || newData.val() === data.val())"
        },
        "expiresAt": {
          ".validate": "newData.isNumber() && ((!data.exists() && newData.val() > now && newData.val() <= now + 86460000) || newData.val() === data.val())"
        },
        "players": {
          ".validate": "newData.hasChildren()",
          "$player": {
            ".read": "auth != null && root.child('photoRooms').child($room).child('expiresAt').val() > now && (!data.child('uid').exists() || data.child('uid').val() === auth.uid || root.child('photoRooms').child($room).child('host').val() === auth.uid)",
            ".validate": "newData.hasChildren(['name','color','index','online']) && $player.matches(/^[a-f0-9]{36}$/)",
            "name": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40"
            },
            "color": {
              ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F]{6}$/)"
            },
            "index": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 19 && newData.val() % 1 === 0"
            },
            "uid": {
              ".validate": "newData.isString() && (!data.exists() ? newData.val() === auth.uid : newData.val() === data.val())",
              ".write": "auth != null && root.child('photoRooms').child($room).child('expiresAt').val() > now && root.child('photoRooms').child($room).child('players').child($player).exists() && (!data.exists() || data.val() === auth.uid) && newData.val() === auth.uid"
            },
            "online": {
              ".validate": "newData.isBoolean()",
              ".write": "auth != null && root.child('photoRooms').child($room).child('expiresAt').val() > now && root.child('photoRooms').child($room).child('players').child($player).exists() && root.child('photoRooms').child($room).child('players').child($player).child('uid').val() === auth.uid"
            },
            "photo": {
              ".validate": "newData.hasChildren(['url','publicId','sentAt','gameId']) && newData.child('gameId').val() === newData.parent().child('game').child('id').val()",
              "url": {
                ".validate": "newData.isString() && newData.val().length < 1000 && newData.val().matches(/^https:\\/\\/res\\.cloudinary\\.com\\/ua1z1wb8\\/image\\/upload\\/.+/)"
              },
              "publicId": {
                ".validate": "newData.isString() && newData.val().length < 300"
              },
              "sentAt": {
                ".validate": "newData.isNumber() && newData.val() <= now && newData.val() >= now - 10000"
              },
              "$other": {
                ".validate": false
              },
              ".write": "auth != null && root.child('photoRooms').child($room).child('expiresAt').val() > now && root.child('photoRooms').child($room).child('players').child($player).exists() && root.child('photoRooms').child($room).child('players').child($player).child('uid').val() === auth.uid && !data.exists() && newData.exists() && data.parent().child('game').child('phase').val() === 'capture' && now <= data.parent().child('game').child('deadline').val()",
              "gameId": {
                ".validate": "newData.isString() && newData.val().matches(/^[a-f0-9]{36}$/)"
              }
            },
            "$other": {
              ".validate": false
            },
            "clientId": {
              ".validate": "newData.isString() && newData.val().length <= 64 && (root.child('photoRooms').child($room).child('host').val() === auth.uid || !data.exists() || newData.val() === data.val())"
            },
            "activity": {
              ".validate": "newData.val() === 'lobby' || newData.val() === 'photo' || newData.val() === 'board' || newData.val() === 'mini'"
            },
            "vote": {
              ".write": "auth != null && root.child('photoRooms').child($room).child('expiresAt').val() > now && root.child('photoRooms').child($room).child('players').child($player).exists() && root.child('photoRooms').child($room).child('players').child($player).child('uid').val() === auth.uid && !data.exists() && newData.exists() && data.parent().child('game').child('phase').val() === 'vote' && data.parent().child('game').child('canVote').val() === true && now <= data.parent().child('game').child('deadline').val()",
              ".validate": "newData.hasChildren(['gameId','round','choice','at']) && newData.child('gameId').val() === newData.parent().child('game').child('id').val() && newData.child('round').val() === newData.parent().child('game').child('round').val()",
              "gameId": {
                ".validate": "newData.isString()"
              },
              "round": {
                ".validate": "newData.isNumber()"
              },
              "choice": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3 && newData.val() % 1 === 0"
              },
              "at": {
                ".validate": "newData.isNumber() && newData.val() <= now && newData.val() >= now - 10000"
              },
              "$other": {
                ".validate": false
              }
            },
            "game": {
              ".validate": "newData.hasChildren(['id','phase','deadline','round']) && root.child('photoRooms').child($room).child('host').val() === auth.uid",
              "id": {
                ".validate": "newData.isString() && newData.val().matches(/^[a-f0-9]{36}$/)"
              },
              "phase": {
                ".validate": "newData.val() === 'capture' || newData.val() === 'order' || newData.val() === 'vote' || newData.val() === 'reveal' || newData.val() === 'final'"
              },
              "deadline": {
                ".validate": "newData.isNumber()"
              },
              "round": {
                ".validate": "newData.isNumber()"
              },
              "prompt": {
                ".validate": "newData.isString() && newData.val().length <= 300"
              },
              "subjectName": {
                ".validate": "newData.isString() && newData.val().length <= 40"
              },
              "canVote": {
                ".validate": "newData.isBoolean()"
              },
              "points": {
                ".validate": "newData.isNumber()"
              },
              "correct": {
                ".validate": "newData.isBoolean()"
              },
              "answer": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3"
              },
              "options": {
                "$option": {
                  ".validate": "$option.matches(/^[0-3]$/) && newData.isString() && newData.val().length <= 300"
                }
              },
              "$other": {
                ".validate": false
              }
            },
            "controller": {
              ".validate": "root.child('photoRooms').child($room).child('host').val() === auth.uid && newData.hasChildren(['version','sessionId','title','canAct','ac','stars'])"
            },
            "boardCommand": {
              ".write": "auth != null && data.parent().child('uid').val() === auth.uid && root.child('photoRooms').child($room).child('expiresAt').val() > now && (data.parent().child('activity').val() === 'board' || data.parent().child('activity').val() === 'mini') && data.parent().child('controller').child('canAct').val() === true && newData.child('version').val() === data.parent().child('controller').child('version').val() && data.parent().child('controller').child('actions').child(newData.child('action').val()).exists() && data.parent().child('controller').child('actions').child(newData.child('action').val()).child('disabled').val() === false",
              ".validate": "newData.hasChildren(['version','action','nonce'])",
              "version": {
                ".validate": "newData.isString() && newData.val().length <= 128"
              },
              "action": {
                ".validate": "newData.isString() && newData.val().length <= 64"
              },
              "nonce": {
                ".validate": "newData.isString() && newData.val().length <= 100"
              },
              "value": {
                ".validate": "newData.isString() && newData.val().length <= 1500"
              },
              "$other": {
                ".validate": false
              }
            },
            "reaction": {
              ".write": "auth != null && data.parent().child('uid').val() === auth.uid && root.child('photoRooms').child($room).child('expiresAt').val() > now && (data.parent().child('activity').val() === 'board' || data.parent().child('activity').val() === 'mini' || data.parent().child('activity').val() === 'photo') && (!data.exists() || data.child('sentAt').val() <= now - 2000) && !data.parent().child(\"controller\").child(\"garou\").exists()",
              ".validate": "newData.hasChildren(['id','nonce','sentAt'])",
              "id": {
                ".validate": "newData.isString() && (newData.val() === 'guez' || newData.val() === 'noob' || newData.val() === 'ff' || newData.val() === 'chad' || newData.val() === 'goat' || newData.val() === 'porto' || newData.val() === 'aboubakar' || newData.val() === 'skibidi' || newData.val() === 'zzz' || newData.val() === 'pog' || newData.val() === 'plait-il' || newData.val() === 'yuki' || newData.val() === 'zebi' || newData.val() === 'mashallah' || newData.val() === 'mog' || newData.val() === '67' || newData.val() === 'tigre')"
              },
              "nonce": {
                ".validate": "newData.isString() && newData.val().length <= 100"
              },
              "sentAt": {
                ".validate": "newData.isNumber() && newData.val() <= now && newData.val() >= now - 10000"
              },
              "$other": {
                ".validate": false
              }
            },
            "memePhoto": {
              ".write": "auth != null && data.parent().child('uid').val() === auth.uid && root.child('photoRooms').child($room).child('expiresAt').val() > now && data.parent().child('activity').val() === 'mini' && data.parent().child('controller').child('game').val() === 'aboubameme' && data.parent().child('controller').child('actions').child('photo').child('disabled').val() === false && data.parent().child('controller').child('canAct').val() === true && now <= data.parent().child('controller').child('deadline').val() && (!data.exists() || data.child('phaseId').val() !== newData.child('phaseId').val())",
              ".validate": "newData.hasChildren(['url','publicId','gameId','phaseId','sentAt']) && newData.child('gameId').val() === newData.parent().child('controller').child('sessionId').val() && newData.child('phaseId').val() === newData.parent().child('controller').child('meme').child('phaseId').val()",
              "url": {
                ".validate": "newData.isString() && newData.val().length < 1000 && newData.val().matches(/^https:\\/\\/res\\.cloudinary\\.com\\/ua1z1wb8\\/image\\/upload\\/.+/)"
              },
              "publicId": {
                ".validate": "newData.isString() && newData.val().length < 300"
              },
              "gameId": {
                ".validate": "newData.isString() && newData.val().matches(/^[a-f0-9]{36}$/)"
              },
              "phaseId": {
                ".validate": "newData.isString() && newData.val().length <= 100"
              },
              "sentAt": {
                ".validate": "newData.isNumber() && newData.val() <= now && newData.val() >= now - 10000"
              },
              "$other": {
                ".validate": false
              }
            },
            "drawingPhoto": {
              ".write": "auth != null && data.parent().child('uid').val() === auth.uid && root.child('photoRooms').child($room).child('expiresAt').val() > now && data.parent().child('activity').val() === 'mini' && data.parent().child('controller').child('game').val() === 'aboubadessin' && data.parent().child('controller').child('actions').child('upload').child('disabled').val() === false && data.parent().child('controller').child('canAct').val() === true && now <= data.parent().child('controller').child('drawing').child('uploadUntil').val() && (!data.exists() || data.child('phaseId').val() !== newData.child('phaseId').val())",
              ".validate": "newData.hasChildren(['url','publicId','gameId','phaseId','sentAt']) && newData.child('gameId').val() === newData.parent().child('controller').child('sessionId').val() && newData.child('phaseId').val() === newData.parent().child('controller').child('drawing').child('phaseId').val()",
              "url": {
                ".validate": "newData.isString() && newData.val().length < 1000 && newData.val().matches(/^https:\\/\\/res\\.cloudinary\\.com\\/ua1z1wb8\\/image\\/upload\\/.+/)"
              },
              "publicId": {
                ".validate": "newData.isString() && newData.val().length < 300"
              },
              "gameId": {
                ".validate": "newData.isString() && newData.val().matches(/^[a-f0-9]{36}$/)"
              },
              "phaseId": {
                ".validate": "newData.isString() && newData.val().length <= 100"
              },
              "sentAt": {
                ".validate": "newData.isNumber() && newData.val() <= now && newData.val() >= now - 10000"
              },
              "$other": {
                ".validate": false
              }
            }
          }
        },
        "$other": {
          ".validate": false
        },
        "boardMap": {
          ".read": "auth != null && root.child('photoRooms').child($room).child('expiresAt').val() > now",
          ".validate": "root.child('photoRooms').child($room).child('host').val() === auth.uid && newData.hasChildren(['id','name','nodes'])"
        }
      }
    },
    "roomDirectory": {
      ".read": "auth != null",
      "$room": {
        ".write": "auth != null && (!newData.exists() || (newData.child('host').val() === auth.uid && (!data.exists() || data.child('host').val() === auth.uid)))",
        ".validate": "$room.matches(/^[a-f0-9]{36}$/) && newData.hasChildren(['host','createdAt','expiresAt','players'])",
        "host": {
          ".validate": "newData.isString() && newData.val() === auth.uid"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "expiresAt": {
          ".validate": "newData.isNumber()"
        },
        "players": {
          "$index": {
            ".validate": "$index.matches(/^([0-9]|1[0-9])$/) && newData.hasChildren(['name','color'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "color": {
              ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F]{6}$/)"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}